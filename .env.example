# Ejemplo Groq: conserva en tu entorno el proveedor y modelo que uses.
# Configurar estos valores en .env.local (no versionado) o en Vercel.
# La clave real solo debe guardarse en esos entornos, nunca en este archivo.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Plan gratuito de Groq: 8000 tokens/minuto para este modelo. Cada evaluación usa
# ~3300-3600 tokens reales (entrada + razonamiento + salida): unas 2 por minuto.
# Un 429 pausa las llamadas para todas las instancias durante Retry-After.
# auto: JSON Schema estricto para Groq GPT-OSS; esquema en el prompt para otros.
# json_schema/json_object solo si tu proveedor y modelo admiten ese formato.
# text conserva el formato compatible tradicional; se valida igualmente.
LLM_RESPONSE_FORMAT=auto

# Respaldo automático de IA (docs/IA_MULTIPROVEEDOR.md). Groq sigue siendo el
# principal con las variables LLM_* anteriores (o GROQ_API_KEY/GROQ_MODEL/GROQ_BASE_URL).
# Ante 429, falta de crédito, timeout, error de red o 5xx de Groq, la misma
# solicitud se envía una vez a OpenAI. Sin AI_FALLBACK_ENABLED=true nada cambia.
# Activarlo cambia el manifiesto: con un experimento abierto, la práctica se
# detiene hasta congelar un experimento nuevo con esta configuración.
AI_PRIMARY_PROVIDER=groq
AI_FALLBACK_PROVIDER=openai
AI_FALLBACK_ENABLED=false
OPENAI_API_KEY=
# Identificador verificado en la API el 2026-11-18. Alternativa de mayor costo: gpt-6.2-sol.
OPENAI_MODEL=gpt-6-luna
# Opcional y propio de cada modelo (gpt-6-luna admite none, low, ...; gpt-6.2-sol no admite none).
OPENAI_REASONING_EFFORT=low
# Presupuesto interno mensual de OpenAI estimado con precios públicos. No es un
# límite de facturación: configura también un límite en la cuenta de OpenAI.
OPENAI_MONTHLY_BUDGET_USD=5
# Ajustes opcionales (valores por defecto):
# GROQ_TIMEOUT_MS=20000        (45000 si no hay respaldo)
# OPENAI_TIMEOUT_MS=30000
# AI_TOTAL_TIMEOUT_MS=50000    (la ruta de práctica tiene 60 s en Vercel)
# AI_CIRCUIT_COOLDOWN_S=30     (pausa del principal tras un timeout o error de red)
# GROQ_MAX_OUTPUT_TOKENS= / OPENAI_MAX_OUTPUT_TOKENS=   (tope por solicitud)
# OPENAI_PRICE_INPUT_USD_PER_MTOK= / OPENAI_PRICE_CACHED_INPUT_USD_PER_MTOK= / OPENAI_PRICE_OUTPUT_USD_PER_MTOK=
#   obligatorios para un modelo fuera de la tabla de lib/proveedores-ia.js

# Clerk: identidad obligatoria para practicar. Cada ruta verifica la sesión.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Almacén compartido (PostgreSQL). Obligatorio en Vercel y en cualquier
# despliegue con más de una instancia. Sin él, un solo host usa PGlite en
# PYDEFENSE_DB_DIR (por defecto .pydefense-data); detén el servidor antes de
# ejecutar los scripts operativos sobre ese directorio.
DATABASE_URL=
# PYDEFENSE_DB_DIR=
# PYDEFENSE_DB_POOL=3

# Obligatorios, de al menos 16 caracteres, distintos entre sí y de las claves de IA.
# Cifran el contenido de las prácticas y las huellas de código (HMAC).
# Cambiarlos durante un experimento invalida contenido y comparaciones de novedad.
PYDEFENSE_SESSION_SECRET=
PYDEFENSE_HUELLA_SECRET=

# Experimento abierto (npm run experimento -- ayuda). Mientras esté abierto, la
# práctica solo arranca si el manifiesto desplegado coincide con el congelado.
# PYDEFENSE_EXPERIMENTO=
# Commit desplegado, parte del manifiesto (en Vercel se usa VERCEL_GIT_COMMIT_SHA).
# PYDEFENSE_COMMIT=
# Cuotas diarias de evaluaciones con IA, compartidas por todas las instancias.
# PYDEFENSE_CUOTA_USUARIO_DIA=40
# PYDEFENSE_CUOTA_GLOBAL_DIA=600
# Contacto del responsable mostrado en el consentimiento.
# PYDEFENSE_CONTACTO=
# Dominio público definitivo para el QR imprimible del stand (/expo/qr).
# Sin él, la página usa el dominio por el que se abrió y lo advierte.
# PYDEFENSE_DOMINIO_PUBLICO=https://pydefense.example
# Token de operador para GET /api/salud (Python disponible, método de análisis).
# PYDEFENSE_SALUD_TOKEN=
# Interruptores de reversión: invitaciones/medición de visitas y encuesta.
# PYDEFENSE_INVITACIONES=desactivadas
# PYDEFENSE_ENCUESTA=desactivada
# Campaña del evento para invitaciones, visitas y encuesta.
# PYDEFENSE_CAMPANA=expoandes-2026
# Gemini: API compatible con Chat Completions para generar y evaluar preguntas.
# Configurar estos valores en .env.local (no versionado) o en Vercel.
# La clave real solo debe guardarse en esos entornos, nunca en este archivo.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash

# Refuerzo opcional generado por IA a partir del programa inicial y de las
# respuestas (2 llamadas más por refuerzo, unos 0,0005 USD con gpt-6-luna).
# Se valida en el servidor y una segunda llamada recalcula los resultados; si
# algo no cuadra se usa el catálogo revisado. «desactivado» usa solo el catálogo.
# PYDEFENSE_REFUERZO_GENERADO=activado
# Sin ejercicio por defecto: si el primer intento se rechaza, el segundo usa este
# modelo de OpenAI (más caro, unos 0,02 USD). Vacío: repite con el proveedor normal.
# AI_REFUERZO_MODELO_ALTERNATIVO=gpt-6.2-sol
# Preguntas redactadas por IA a partir del programa y de las respuestas (1 llamada
# por pregunta); si no pasan la validación se usa la plantilla.
# PYDEFENSE_PREGUNTAS_GENERADAS=activado
