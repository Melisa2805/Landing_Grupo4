# Ejemplo Groq: conserva en tu entorno el proveedor y modelo que uses.
# Configurar estos valores en .env.local (no versionado) o en Vercel.
# La clave real solo debe guardarse en esos entornos, nunca en este archivo.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Plan gratuito de Groq: 8000 tokens/minuto para este modelo. Cada evaluación usa
# ~3300-3600 tokens reales (entrada + razonamiento + salida): unas 2 por minuto.
# Un 429 se registra como LLM_LIMITE detalle=http_429; los siguientes, con
# detalle=espera_proveedor, se rechazan localmente sin llamar al proveedor.
# auto: JSON Schema estricto para Groq GPT-OSS; esquema en el prompt para otros.
# json_schema/json_object solo si tu proveedor y modelo admiten ese formato.
# text conserva el formato compatible tradicional; se valida igualmente.
LLM_RESPONSE_FORMAT=auto
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Solo para el servidor local u otros servidores con disco persistente.
# En Vercel (VERCEL=1) se usa un token cifrado portátil y se ignora este directorio.
# No apuntar a /tmp como solución de persistencia entre funciones de Vercel.
# Directorio privado persistente. En varias réplicas debe ser compartido y
# soportar creación exclusiva de directorios y renombrado atómico.
# PYDEFENSE_SESSION_DIR=/ruta/privada/pydefense-sessions
# Opcional: clave estable independiente de las credenciales del proveedor.
# PYDEFENSE_SESSION_SECRET=
PYDEFENSE_MAX_PREGUNTAS=5
