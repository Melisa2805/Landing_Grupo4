# Gemini: API compatible con Chat Completions para generar y evaluar preguntas.
# Configurar estos valores en .env.local (no versionado) o en Vercel.
# La clave real solo debe guardarse en esos entornos, nunca en este archivo.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
