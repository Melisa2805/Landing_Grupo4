# Ejemplo Groq: conserva en tu entorno el proveedor y modelo que uses.
# Configurar estos valores en .env.local (no versionado) o en Vercel.
# La clave real solo debe guardarse en esos entornos, nunca en este archivo.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Plan gratuito de Groq: 8000 tokens/minuto para este modelo. Cada evaluación usa
# ~3300-3600 tokens reales (entrada + razonamiento + salida): unas 2 por minuto.
# Un 429 pausa las llamadas para todas las instancias durante Retry-After.
# auto: JSON Schema estricto para Groq GPT-OSS; esquema en el prompt para otros.
# json_schema/json_object solo si tu proveedor y modelo admiten ese formato.
# text conserva el formato compatible tradicional; se valida igualmente.
LLM_RESPONSE_FORMAT=auto

# Clerk: identidad obligatoria para practicar. Cada ruta verifica la sesión.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Almacén compartido (PostgreSQL). Obligatorio en Vercel y en cualquier
# despliegue con más de una instancia. Sin él, un solo host usa PGlite en
# PYDEFENSE_DB_DIR (por defecto .pydefense-data); detén el servidor antes de
# ejecutar los scripts operativos sobre ese directorio.
DATABASE_URL=
# PYDEFENSE_DB_DIR=
# PYDEFENSE_DB_POOL=3

# Obligatorios, de al menos 16 caracteres, distintos entre sí y de LLM_API_KEY.
# Cifran el contenido de las prácticas y las huellas de código (HMAC).
# Cambiarlos durante un experimento invalida contenido y comparaciones de novedad.
PYDEFENSE_SESSION_SECRET=
PYDEFENSE_HUELLA_SECRET=

# Experimento abierto (npm run experimento -- ayuda). Mientras esté abierto, la
# práctica solo arranca si el manifiesto desplegado coincide con el congelado.
# PYDEFENSE_EXPERIMENTO=
# Commit desplegado, parte del manifiesto (en Vercel se usa VERCEL_GIT_COMMIT_SHA).
# PYDEFENSE_COMMIT=
# Cuotas diarias de evaluaciones con IA, compartidas por todas las instancias.
# PYDEFENSE_CUOTA_USUARIO_DIA=40
# PYDEFENSE_CUOTA_GLOBAL_DIA=600
# Contacto del responsable mostrado en el consentimiento.
# PYDEFENSE_CONTACTO=
